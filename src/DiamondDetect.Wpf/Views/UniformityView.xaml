<UserControl x:Class="DiamondDetect.Wpf.Views.UniformityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="均匀度分析"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageHintStyle}" Text="{Binding PageHintText}"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <GroupBox Header="产品输出根目录" Margin="0,0,0,8" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="选择目录" Width="88" Height="34" Margin="0,0,8,0"
                                Command="{Binding BrowseOutputRootCommand}"/>
                        <Button Content="扫描" Width="72" Height="34" Margin="0,0,8,0"
                                Command="{Binding ScanTilesCommand}"
                                IsEnabled="{Binding CanRun}"/>
                        <Button Content="打开" Width="72" Height="34"
                                Command="{Binding OpenOutputRootCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
            </GroupBox>

            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="det_conf ≥" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="64" Text="{Binding ConfThresholdText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Content="同时生成可视化" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding WriteVisualization}"
                              ToolTip="默认关闭；勾选后对本次勾选子图写出 uniformity_vis.jpg"/>
                    <Button Content="全选" Width="56" Height="30" Margin="0,0,6,0"
                            Command="{Binding SelectAllTilesCommand}"/>
                    <Button Content="全不选" Width="64" Height="30" Margin="0,0,10,0"
                            Command="{Binding SelectNoneTilesCommand}"/>
                    <TextBlock Text="{Binding TileListText}" VerticalAlignment="Center" Foreground="#546E7A"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始分析" Height="34" Width="100"
                            Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"/>
                    <Button Content="停止" Width="72" Height="34" Margin="8,0,0,0"
                            Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                </StackPanel>
            </DockPanel>

            <ProgressBar Height="22" Margin="0,0,0,4"
                         Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StageText}" Foreground="#546E7A" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding StageVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="子图勾选" Padding="6" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Tiles}"
                          Style="{StaticResource VirtualizedDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                        <DataGridTextColumn Header="子图" Binding="{Binding Image}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="源" Binding="{Binding SourceKindText}" Width="52" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="均匀度分数" Padding="6" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          Style="{StaticResource VirtualizedDataGridStyle}"
                          IsReadOnly="True" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="图像" Binding="{Binding Image}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="n_points" Binding="{Binding NPointsText}" Width="64"/>
                        <DataGridTextColumn Header="voronoi_cv_n" Binding="{Binding VoronoiText}" Width="90"/>
                        <DataGridTextColumn Header="nn_cv_n" Binding="{Binding NnText}" Width="80"/>
                        <DataGridTextColumn Header="clark_evans_R" Binding="{Binding ClarkEvansText}" Width="90"/>
                        <DataGridTextColumn Header="delaunay_cv_n" Binding="{Binding DelaunayText}" Width="90"/>
                        <DataGridTextColumn Header="grid_cv" Binding="{Binding GridText}" Width="70"/>
                        <DataGridTextColumn Header="status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="可视化预览" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="重新生成" Height="30" Padding="12,0" Margin="0,0,8,0"
                                Command="{Binding RegenerateVisCommand}"
                                IsEnabled="{Binding CanRegenerateVis}"/>
                        <Button Content="打开文件" Height="30" Padding="12,0"
                                Command="{Binding OpenVisFileCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewMeta}"
                               TextWrapping="Wrap" Foreground="#546E7A" FontSize="11" Margin="0,6,0,0"/>
                    <Border Background="#FAFBFC" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="6"
                               RenderOptions.BitmapScalingMode="LowQuality"/>
                    </Border>
                </DockPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding SummaryText}"
                   Foreground="#1565C0" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
