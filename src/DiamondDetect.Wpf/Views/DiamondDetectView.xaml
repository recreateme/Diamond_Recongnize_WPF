<UserControl x:Class="DiamondDetect.Wpf.Views.DiamondDetectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="钻石检测分类"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageHintStyle}" Text="{Binding PageHintText}"/>

        <!-- 模式 / 输出并排，降低纵向高度，避免底部「结果保存目录」被裁切 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="处理模式" Padding="10">
                <StackPanel>
                    <CheckBox Content="仅检测定位（不分类）"
                              IsChecked="{Binding DetectOnly}" Margin="0,0,0,8"
                              ToolTip="只输出 detect_boxes.json / .csv，不跑朝向分类"/>
                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding DetectOnly}">
                        <CheckBox Content="检测前下采样，最长边"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DownsampleEnabled}" Margin="0,0,4,4"
                                  ToolTip="源图更长边缩到右侧像素；仅「仅检测定位」可用"/>
                        <TextBox Width="56" VerticalAlignment="Center" Margin="0,0,4,4"
                                 Text="{Binding DownsampleMaxSide, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <TextBlock Text="插值" VerticalAlignment="Center" Margin="0,0,6,4"/>
                        <ComboBox Width="100" VerticalAlignment="Center" Margin="0,0,0,4"
                                  ItemsSource="{Binding InterpolationOptions}"
                                  SelectedItem="{Binding SelectedInterpolation}"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="输出选项" Padding="10">
                <StackPanel>
                    <CheckBox Content="保存可视化结果" Margin="0,0,0,8"
                              IsChecked="{Binding SaveVisualization}"
                              ToolTip="完整模式：分类着色图；仅检测：绿框检测图"/>
                    <CheckBox Content="保存裁剪切片 crop/" Margin="0,0,0,8"
                              IsChecked="{Binding SaveCrops}"
                              ToolTip="完整模式按类别分子目录；仅检测为平铺编号图"/>
                    <CheckBox Content="完成后计算均匀度"
                              IsChecked="{Binding RunUniformityAfter}"
                              IsEnabled="{Binding DetectOnly, Converter={StaticResource InvertBool}}"
                              ToolTip="仅完整模式；写入 uniformity_scores.json / uniformity_summary.csv"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3" Header="输入图像" Margin="0,0,0,10" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="选择文件" Width="96" Height="34" Margin="0,0,8,0"
                            Command="{Binding BrowseFilesCommand}"/>
                    <Button Content="选择文件夹" Width="96" Height="34"
                            Command="{Binding BrowseFolderCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding InputPathText}"
                               TextWrapping="Wrap"
                               FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                               MinHeight="34" VerticalAlignment="Center"
                               ToolTip="{Binding InputPathText}"/>
                    <TextBlock Text="{Binding ImageCountText}" Foreground="#546E7A" FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="结果保存目录" Margin="0,0,0,10" Padding="10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="选择目录" MinWidth="96" Height="34"
                        Margin="12,0,0,0" Padding="12,0"
                        Command="{Binding BrowseOutputCommand}"/>
                <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34" Height="34"
                         VerticalContentAlignment="Center"
                         HorizontalScrollBarVisibility="Auto"
                         ToolTip="{Binding OutputDir}"/>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,8">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始处理" Height="36"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>
                <Button Content="停止" Width="80" Height="36" Margin="8,0,0,0"
                        Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                <Button Content="打开结果目录" Height="36" Margin="8,0,0,0"
                        Command="{Binding OpenOutputCommand}"/>
            </DockPanel>
            <ProgressBar Height="22" Margin="0,0,0,6"
                         Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StageText}" Foreground="#546E7A" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding StageVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <GroupBox Grid.Row="6" Header="结果统计" Padding="8">
            <DataGrid ItemsSource="{Binding Rows}"
                      Style="{StaticResource VirtualizedDataGridStyle}"
                      IsReadOnly="True" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图像" Binding="{Binding Image}" Width="SizeToCells"/>
                    <DataGridTextColumn Header="钻石数" Binding="{Binding DiamondsText}" Width="70"/>
                    <DataGridTextColumn Header="缺陷类别分布" Binding="{Binding Distribution}" Width="*"/>
                    <DataGridTextColumn Header="总耗时(s)" Binding="{Binding TimeText}" Width="90"/>
                    <DataGridTextColumn Header="保存目录" Binding="{Binding OutputDir}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="7" Text="{Binding TotalText}"
                   Foreground="#1565C0" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
