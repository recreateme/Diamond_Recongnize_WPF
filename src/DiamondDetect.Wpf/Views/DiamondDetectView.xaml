<UserControl x:Class="DiamondDetect.Wpf.Views.DiamondDetectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MaxHeight="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="钻石检测分类"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageHintStyle}" Text="{Binding PageHintText}"/>

        <!-- 配置区：窗口较矮时可滚动 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <GroupBox Header="处理模式" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <CheckBox Content="仅检测定位（不分类，输出 detect_boxes.json / .csv）"
                                  IsChecked="{Binding DetectOnly}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding DetectOnly}">
                            <CheckBox Content="检测前下采样（最长边缩至" VerticalAlignment="Center"
                                      IsChecked="{Binding DownsampleEnabled}" Margin="0,0,4,0"/>
                            <TextBox Width="56" VerticalAlignment="Center" Margin="0,0,4,0"
                                     Text="{Binding DownsampleMaxSide, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="px）" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="插值：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="120" VerticalAlignment="Center"
                                      ItemsSource="{Binding InterpolationOptions}"
                                      SelectedItem="{Binding SelectedInterpolation}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="输出选项" Margin="0,0,0,10" Padding="10">
                    <CheckBox Content="保存可视化结果（检测+分类：分类着色图；仅检测：绿框检测图）"
                              IsChecked="{Binding SaveVisualization}"/>
                </GroupBox>

                <GroupBox Header="输入图像" Margin="0,0,0,10" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="选择文件" Width="96" Height="34" Margin="0,0,8,0"
                                    Command="{Binding BrowseFilesCommand}"/>
                            <Button Content="选择文件夹" Width="96" Height="34"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding InputPathText}" TextWrapping="Wrap" FontSize="15"
                                       FontWeight="SemiBold" Foreground="#37474F" MinHeight="48"/>
                            <TextBlock Text="{Binding ImageCountText}" Foreground="#546E7A" FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="结果保存目录" Padding="10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="选择目录" Width="96" Height="34" Margin="10,0,0,0"
                                Command="{Binding BrowseOutputCommand}"/>
                        <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 控制与进度：始终可见 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,8">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始处理" Height="36"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>
                <Button Content="停止" Width="80" Height="36" Margin="8,0,0,0"
                        Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                <Button Content="打开结果目录" Height="36" Margin="8,0,0,0"
                        Command="{Binding OpenOutputCommand}"/>
            </DockPanel>
            <ProgressBar Height="22" Margin="0,0,0,6"
                         Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StageText}" Foreground="#546E7A" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding StageVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <GroupBox Grid.Row="4" Header="结果统计" Padding="8">
            <DataGrid ItemsSource="{Binding Rows}"
                      Style="{StaticResource VirtualizedDataGridStyle}"
                      IsReadOnly="True" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图像" Binding="{Binding Image}" Width="SizeToCells"/>
                    <DataGridTextColumn Header="钻石数" Binding="{Binding DiamondsText}" Width="70"/>
                    <DataGridTextColumn Header="缺陷类别分布" Binding="{Binding Distribution}" Width="*"/>
                    <DataGridTextColumn Header="总耗时(s)" Binding="{Binding TimeText}" Width="90"/>
                    <DataGridTextColumn Header="保存目录" Binding="{Binding OutputDir}" Width="SizeToCells"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="5" Text="{Binding TotalText}"
                   Foreground="#1565C0" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
