<UserControl x:Class="DiamondDetect.Wpf.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitleStyle}" Text="缺陷检测"/>
        <TabControl>
            <!-- 单张 -->
            <TabItem Header="单张检测">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Height="280" BorderBrush="#90A4AE" BorderThickness="2"
                                CornerRadius="8" Background="#FAFBFC"
                                MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
                            <Grid>
                                <TextBlock Text="点击或拖入图像" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#90A4AE"
                                           Visibility="{Binding SinglePreview, Converter={StaticResource NullToVis}}"/>
                                <Image Source="{Binding SinglePreview}" Stretch="Uniform" Margin="8"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始检测"
                                Margin="0,10,0,0" Height="36"
                                Command="{Binding RunSingleCommand}"
                                IsEnabled="{Binding IsSingleBusy, Converter={StaticResource InvertBool}}"/>
                        <Button Content="导出分类结果" Margin="0,8,0,0" Height="36"
                                Command="{Binding ExportSingleCommand}"
                                IsEnabled="{Binding CanExportSingle}"/>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource CardBrush}"
                            BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="18">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="预测结果" Foreground="#90A4AE" FontSize="12"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PredictedClass}"
                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{Binding PredictedClassBrush}" Margin="0,8,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ConfidenceText}"
                                       HorizontalAlignment="Center" Foreground="#546E7A" Margin="0,0,0,12"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ElapsedText}"
                                       Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Right"/>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ScoreBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#455A64"
                                                           VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="11"
                                                           Foreground="#78909C" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 批量 -->
            <TabItem Header="批量检测">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="浏览" Width="70" Margin="8,0,0,0"
                                Command="{Binding BrowseFolderCommand}"/>
                        <TextBox Text="{Binding FolderPath}" IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="批量检测"
                                Command="{Binding RunBatchCommand}"
                                IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InvertBool}}"/>
                        <Button Content="停止" Width="80" Margin="8,0,0,0"
                                Command="{Binding StopBatchCommand}"
                                IsEnabled="{Binding IsBatchRunning}"/>
                        <TextBlock Text="{Binding FolderInfo}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" Foreground="#546E7A"/>
                    </DockPanel>
                    <ProgressBar DockPanel.Dock="Top" Height="12" Margin="0,0,0,8"
                                 Minimum="0" Maximum="{Binding BatchMaximum}" Value="{Binding BatchProgress}"
                                 Visibility="{Binding BatchProgressVisible, Converter={StaticResource BoolToVis}}"/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="导出分类结果" Command="{Binding ExportBatchCommand}"
                                IsEnabled="{Binding CanExportBatch}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="查看全部结果 →"
                                HorizontalAlignment="Right" Command="{Binding GoResultsCommand}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding BatchRows}"
                              Style="{StaticResource VirtualizedDataGridStyle}"
                              IsReadOnly="True" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="预测类别" Binding="{Binding Class}" Width="120"/>
                            <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}" Width="90"/>
                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ElapsedText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
