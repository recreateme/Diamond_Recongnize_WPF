<UserControl x:Class="DiamondDetect.Wpf.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="20"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置"/>
                <TextBlock x:Name="ModeText" Style="{StaticResource PageHintStyle}"/>
                <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="UnlockBtn" DockPanel.Dock="Right" Content="输入密码解锁"
                                Padding="12,4" Click="Unlock_Click"/>
                        <TextBlock x:Name="LockStatus" VerticalAlignment="Center"
                                   Foreground="#F57F17" Text="锁定状态"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存配置"
                        Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="重新加载模型" Padding="16,8" Click="Reload_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel">
                    <TabControl>
                        <TabItem Header="分类配置">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PyTorch 模型 (.pt)" VerticalAlignment="Center"/>
                                <TextBox x:Name="PtPathBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Text="ONNX 模型" VerticalAlignment="Center"/>
                                <TextBox x:Name="OnnxPathBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                <CheckBox x:Name="UseGpuBox" Grid.Row="2" Grid.Column="1"
                                          Content="使用 GPU" Margin="0,8,0,0"/>
                                <CheckBox x:Name="LocalDiagBox" Grid.Row="3" Grid.Column="1"
                                          Content="启用本地诊断日志（logs/diag.jsonl，默认关，不上传）"
                                          Margin="0,10,0,0"
                                          ToolTip="仅写入本机 logs/diag.jsonl，便于排查卡顿与失败，从不联网上传。"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="切片推理配置">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="YOLO 权重" VerticalAlignment="Center"/>
                                <TextBox x:Name="YoloPathBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="设备 (auto/cpu/cuda:0)" VerticalAlignment="Center"/>
                                <TextBox x:Name="SahiDeviceBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="切片尺寸" VerticalAlignment="Center"/>
                                <TextBox x:Name="SliceSizeBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Text="重叠比例" VerticalAlignment="Center"/>
                                <TextBox x:Name="OverlapBox" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Text="检测置信度" VerticalAlignment="Center"/>
                                <TextBox x:Name="DetConfBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Text="批次大小" VerticalAlignment="Center"/>
                                <TextBox x:Name="BatchSizeBox" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="6" Text="裁剪 padding" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaddingBox" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="7" Text="输出目录" VerticalAlignment="Center"/>
                                <TextBox x:Name="OutputDirBox" Grid.Row="7" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="8" Text="IoS 阈值" VerticalAlignment="Center"/>
                                <TextBox x:Name="IosBox" Grid.Row="8" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="9" Text="最小面积比" VerticalAlignment="Center"/>
                                <TextBox x:Name="MinAreaBox" Grid.Row="9" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Grid.Row="10" Text="最大长宽比" VerticalAlignment="Center"/>
                                <TextBox x:Name="AspectBox" Grid.Row="10" Grid.Column="1" Margin="0,3"/>
                                <CheckBox x:Name="EdgeFilterBox" Grid.Row="11" Grid.Column="1"
                                          Content="边缘过滤" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="12" Text="边缘边距 (px)" VerticalAlignment="Center"/>
                                <TextBox x:Name="EdgeMarginBox" Grid.Row="12" Grid.Column="1" Margin="0,3"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
